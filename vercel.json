{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/briefing.html", "dest": "/public/briefing.html" },
    { "src": "/favicon.ico", "status": 204 },
    {
      "src": "/(auth|users|teams|tasks|campaigns|notifications|briefing|approvals|demands|job-applications|dashboard|docs|health)(.*)",
      "dest": "/api/index.ts"
    },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
